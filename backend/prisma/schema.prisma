generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  advogado
  escritorio
  despachante
  empresa
  cliente
}

enum AddressType {
  RESIDENTIAL
  PROFESSIONAL
  COMMERCIAL
}

enum ContactType {
  EMAIL
  PHONE
  MOBILE
  WHATSAPP
}

enum ParticipantRole {
  CLIENT
  LAWYER
  LEGAL_REPRESENTATIVE
  PARTY
  WITNESS
  RESPONSIBLE
  OTHER
}

enum LegalRepresentationType {
  LEGAL_REPRESENTATIVE
  AUTO_REPRESENTANTE_LEGAL
}

enum InvitationStatus {
  enviado
  aceito
  expirado
  cancelado
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               Role
  roles              Role[]
  phone              String?
  document           String?
  oab                String?
  section            String?
  emailVerified      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  verificationTokens VerificationToken[]
  invitationsSent    Invitation[]        @relation("InvitationSender")
  invitationsAccepted Invitation[]       @relation("InvitationRecipient")
  addresses          Address[]
  contacts           Contact[]
  processParticipations ProcessParticipant[]
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  document         String   @unique
  address          String?
  phone            String?
  responsibleName  String
  responsibleEmail String
  lawyers          Json
  ownerId          String
  createdAt        DateTime @default(now())
  addresses        Address[]
  contacts         Contact[]
  processes        Process[]
}

model Address {
  id             String       @id @default(uuid())
  type           AddressType
  zipCode        String?
  street         String?
  number         String?
  complement     String?
  district       String?
  city           String?
  state          String?
  country        String?
  reference      String?
  main           Boolean      @default(false)
  active         Boolean      @default(true)
  userId         String?
  organizationId String?
  user           User?        @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Contact {
  id             String       @id @default(uuid())
  type           ContactType
  value          String
  main           Boolean      @default(false)
  active         Boolean      @default(true)
  userId         String?
  organizationId String?
  user           User?        @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Process {
  id            String              @id @default(uuid())
  code          String              @unique
  name          String
  status        String
  createdByUserId String
  organizationId String?
  organization  Organization?       @relation(fields: [organizationId], references: [id])
  participants  ProcessParticipant[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model ProcessParticipant {
  id                    String                  @id @default(uuid())
  processId             String
  userId                String
  organizationId        String?
  role                  ParticipantRole
  active                Boolean                 @default(true)
  enteredAt             DateTime                @default(now())
  exitedAt              DateTime?
  replacedByParticipantId String?
  replacementReason     String?
  representationType    LegalRepresentationType?
  process               Process                 @relation(fields: [processId], references: [id])
  user                  User                    @relation(fields: [userId], references: [id])

  @@index([processId, role, active])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Invitation {
  id          String           @id @default(uuid())
  token       String           @unique
  name        String
  email       String
  message     String?
  expiresAt   DateTime
  status      InvitationStatus @default(enviado)
  senderId    String
  sender      User             @relation("InvitationSender", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?            @relation("InvitationRecipient", fields: [recipientId], references: [id])
  createdAt   DateTime         @default(now())
}